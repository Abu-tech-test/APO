<td width="20%" style="width: 10%; text-align: right"><a href="/wiki/Plik:Bricklayers%27_Kit.gif" class="image"><script src="/cdn-cgi/scripts/7d0fa10a/cloudflare-static/rocket-loader.min.js" data-cf-settings="11158e19b51f9b109657abbe-|49"></script><img alt="Bricklayers&#39; Kit.gif" src="data:image/gif;base64," pagespeed_url_hash="2797599174" onload="pagespeed.CriticalImages.checkImageForCriticality(this);" /></a></td>
